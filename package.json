{
  "name": "dbiq",
  "version": "0.1.0",
  "description": "DBIQ: catch dangerous Postgres migrations before they hit production. Alembic-aware, with real-database dry runs.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "postgres",
    "migrations",
    "alembic",
    "linter",
    "cli",
    "database"
  ],
  "author": "Zak Marmel",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.1.0",
    "libpg-query": "^18.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "dbiq": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Z4kM4rm3l/dbiq"
  }
}
